--- a/libusb/os/darwin_usb.c
+++ b/libusb/os/darwin_usb.c
@@ -2563,9 +2563,24 @@ static int submit_control_transfer(struct usbi_transfer *itransfer) {
 
     kresult = (*IOINTERFACE(cInterface))->ControlRequestAsyncTO (IOINTERFACE(cInterface), pipeRef,
                                                                          &(tpriv->req), darwin_async_io_callback, itransfer);
-  } else
+  } else {
+    usb_device_t device;
+
+    /* Hotplug teardown clears the cached interface under this mutex. Keep a
+     * reference across submission so removal cannot invalidate our snapshot. */
+    usbi_mutex_lock(&darwin_cached_devices_mutex);
+    device = dpriv->device;
+    if (device)
+      (*device)->AddRef(device);
+    usbi_mutex_unlock(&darwin_cached_devices_mutex);
+
+    if (!device)
+      return LIBUSB_ERROR_NO_DEVICE;
+
     /* control request on endpoint 0 */
-    kresult = (*dpriv->device)->DeviceRequestAsyncTO(dpriv->device, &(tpriv->req), darwin_async_io_callback, itransfer);
+    kresult = (*device)->DeviceRequestAsyncTO(device, &(tpriv->req), darwin_async_io_callback, itransfer);
+    (*device)->Release(device);
+  }
 
   if (kresult != kIOReturnSuccess)
     usbi_err (TRANSFER_CTX (transfer), "control request failed: %s", darwin_error_str(kresult));
