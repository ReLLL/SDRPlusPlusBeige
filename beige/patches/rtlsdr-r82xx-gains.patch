+int r82xx_get_gain_stages(struct r82xx_priv *priv, int *lna, int *mixer, int *vga)
+{
+	uint8_t data[4];
+	int result = r82xx_read(priv, 0x00, data, sizeof(data));
+	if (result < 0) return result;
+	int lna_reg = r82xx_read_cache_reg(priv, 0x05);
+	int mixer_reg = r82xx_read_cache_reg(priv, 0x07);
+	/* RF_INDICATOR keeps reporting the AGC estimate in manual mode.
+	 * Use programmed values for manual stages, status only for AGC stages. */
+	*lna = (lna_reg & 0x10) ? (lna_reg & 0x0f) : (data[3] & 0x0f);
+	*mixer = (mixer_reg & 0x10) ? (data[3] >> 4) : (mixer_reg & 0x0f);
+	*vga = r82xx_read_cache_reg(priv, 0x0c) & 0x0f;
+	return 0;
+}
+
+int r82xx_set_gain_stages(struct r82xx_priv *priv, int lna, int mixer, int vga)
+{
+	/* Preserve input switching, power and filter bits. Disable LNA/mixer
+	 * automatic control and the analog VGA pin only in these gain fields. */
+	int result = r82xx_write_reg_mask(priv, 0x05, 0x10 | lna, 0x1f);
+	if (result < 0) return result;
+	result = r82xx_write_reg_mask(priv, 0x07, mixer, 0x1f);
+	if (result < 0) return result;
+	return r82xx_write_reg_mask(priv, 0x0c, vga, 0x1f);
+}
